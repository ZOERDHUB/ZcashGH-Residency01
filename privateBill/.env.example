# ============================================================
# PRIVATE BILL Q9
# Multi-network / Multi-node Zcash payment monitoring
# ============================================================

# Select exactly one active network for this backend process.
# Run separate backend processes if you want Private Bill monitors
# for mainnet and testnet simultaneously.
PRIVATE_BILL_NETWORK=testnet

# zebra | zakura | auto
# auto = Zebra first, Zakura fallback.
PRIVATE_BILL_NODE=auto

# Polling interval used by the frontend (milliseconds).
PAYMENT_POLL_MS=10000

# Confirmations required before an order becomes ZEC_CONFIRMED.
ZCASH_REQUIRED_CONFIRMATIONS=3

# Quest/demo persistence. Replace with a real DB in production.
PRIVATE_BILL_DB=./data/private-bill.json

PORT=8787

# ------------------------------------------------------------
# Optional demo/default deposit address
# ------------------------------------------------------------
# This is only a fallback for the quest UI.
# Production should assign a unique deposit address server-side per order.
VITE_ZEC_RECEIVING_ADDRESS=
VITE_PAYOUT_URL=/api/orders

# ------------------------------------------------------------
# Zebra
# ------------------------------------------------------------
ZEBRA_MAINNET_RPC_URL=http://127.0.0.1:8232
ZEBRA_TESTNET_RPC_URL=http://127.0.0.1:18232
ZEBRA_REGTEST_RPC_URL=http://127.0.0.1:29232

# Prefer cookie authentication for Z3 mainnet/testnet.
# Example when the cookie is mounted/readable by the backend:
# ZEBRA_COOKIE_PATH=/var/run/auth/.cookie
ZEBRA_COOKIE_PATH=

# For a host-side backend, you may provide credentials if your Zebra
# deployment is configured for username/password RPC.
ZEBRA_RPC_USER=
ZEBRA_RPC_PASSWORD=

# Transparent-address block scanning parameters for Zebra.
ZEBRA_SCAN_LOOKBACK=100
ZEBRA_MAX_BLOCKS_PER_SCAN=100

# ------------------------------------------------------------
# Zakura
# ------------------------------------------------------------
ZAKURA_MAINNET_RPC_URL=http://127.0.0.1:8232
ZAKURA_TESTNET_RPC_URL=http://127.0.0.1:18232
ZAKURA_REGTEST_RPC_URL=http://127.0.0.1:29232
ZAKURA_RPC_USER=
ZAKURA_RPC_PASSWORD=
ZAKURA_RPC_MODE=compat

# ------------------------------------------------------------
# Fiat payout layer (Quest 09)
# ------------------------------------------------------------
# Keep the provider behind the backend interface. Until a production
# provider is approved/configured, use the controlled mock provider.
PAYOUT_PROVIDER=mock
# success | failed — useful for deterministic local testing.
MOCK_PAYOUT_MODE=success
